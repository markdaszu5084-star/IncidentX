# IncidentX Backend Configuration
# Copy this file to .env and provide your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Knowledge Base & Vector Store
KNOWLEDGE_BASE_DIR=knowledge_base
FAISS_INDEX_PATH=backend/data/faiss_index.bin

# Security & Upload Constraints
MAX_LOG_FILE_SIZE_BYTES=10485760  # 10MB max upload
ALLOWED_EXTENSIONS=.log,.txt,.json,.csv

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

